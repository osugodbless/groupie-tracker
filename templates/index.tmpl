{{define "landing-page"}}
<div id="index">
    <div>
        <div>

        </div>
        <button
        hx-get="/artists"
        hx-target="#index"
        hx-push-url="true">
            <div class="flex items-center justify-center gap-2 px-6 py-3 bg-neon-cyan/10 border border-neon-cyan/30 rounded-xl text-neon-cyan font-semibold hover:bg-neon-cyan/20 hover:border-neon-cyan/50 transition-all duration-300">
                <span class="hx-indicator hidden">
                    <svg class="animate-spin h-5 w-5" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                </span>
                <span class="hx-not-indicator">View Artists</span>
                <svg class="w-5 h-5 hx-not-indicator" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
            </div>
        </button>
    </div>
</div>
{{end}}
