{{define "artists-page"}}
<div id="artists-page">
    <!-- Hero -->
    <div class="relative overflow-hidden">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 sm:pt-8 pb-8 sm:pb-8">
            <div class="text-center max-w-3xl mx-auto">
                <div class="hero-badge inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/5 border border-white/10 text-sm text-gray-300 mb-8">
                    <span class="w-1.5 h-1.5 rounded-full bg-neon-cyan animate-pulse"></span>
                    Browse the lineup
                </div>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="filters">
        {{template "filters:search" .}}
        {{template "filters:sort" .}}
    </div>

    <!-- Artist Grid -->
    <div id="artists" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-20 sm:pb-28">
        <div class="flex items-center justify-between mb-6">
            <div>
                <div class="w-10 h-0.5 bg-gradient-to-r from-neon-cyan to-neon-purple rounded-full mb-4"></div>
                <h2 class="font-heading text-2xl sm:text-3xl font-bold text-white text-balance">All Artists</h2>
                <p class="text-gray-500 text-sm mt-1">{{ len . }} artists</p>
            </div>
        </div>

        
        <div id="filter-results" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-3 sm:gap-4">
        {{template "artists:grid" .}}
        </div>
    </div>
</div>
{{end}}

{{define "artists:grid"}}
    {{ range . }}
    <div id="{{ .ID }}"
        data-artist-id="{{ .ID }}"
        data-artist-name="{{ .Name }}"
        hx-get="/artists/{{ .ID }}"
        hx-target="#artists-page"
        hx-push-url="true"
        hx-indicator="#loading-{{ .ID }}"
        class="card-glow card-animate group relative rounded-xl overflow-hidden bg-white/5 cursor-pointer hover:-translate-y-0.5 transition-transform duration-300">
        <div class="aspect-square overflow-hidden bg-white/5 relative">
            <img src="{{ .Image }}" alt="{{ .Name }}"
                class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500 ease-out"
                style="view-transition-name: at-{{ .ID }}"
                loading="lazy"
                onerror="this.classList.add('error')">
            <div class="img-fallback" aria-hidden="true">
                <svg viewBox="0 0 24 24" class="w-8 h-8 text-white/20" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"/>
                </svg>
            </div>
        </div>
        <div class="p-3 sm:p-4">
            <p class="font-heading font-semibold text-white text-sm sm:text-base truncate group-hover:text-neon-cyan transition-colors">{{ .Name }}</p>
            <div class="flex items-center gap-1.5 mt-1">
                <span class="w-1.5 h-1.5 rounded-full bg-neon-purple shrink-0"></span>
                <p class="text-xs text-gray-500">Est. {{ .CreationYear }}</p>
            </div>
        </div>
        <div id="loading-{{ .ID }}" class="hx-indicator absolute inset-0 bg-gray-950/80 z-10">
            <div class="p-4 space-y-3">
                <div class="skeleton h-4 bg-white/10 rounded w-3/4"></div>
                <div class="skeleton h-3 bg-white/10 rounded w-1/2"></div>
            </div>
        </div>
    </div>
    {{ else }}
    <div class="col-span-full text-center py-20">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-white/5 mb-4">
            <svg viewBox="0 0 24 24" class="w-8 h-8 text-white/20" fill="none" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"/>
            </svg>
        </div>
        <p class="text-gray-400 text-lg font-medium">No artists found</p>
        <p class="text-gray-600 text-sm mt-1">No artist data to show yet.</p>
    </div>
    {{ end }}
{{end}}

{{define "filters:search"}}
    <div class="search-filter">
        <h3>
            Search Artists
            <span class="htmx-indicator">Searching...</span>
        </h3>
        <input class="form-control" type="search"
            name="search" placeholder="Begin Typing To Search Artists..."
            hx-get="/artists/findx"
            hx-trigger="input changed delay:500ms, keyup[key=='Enter']"
            hx-target="#filter-results"
            hx-indicator=".htmx-indicator"
            hx-push-url="true">
    </div>
{{end}}

{{define "filters:sort"}}
    <div class="sort-filter">
        <h3>Sort Artists</h3>
        <select class="form-control"
            name="sort"
            hx-get="/artists/findx"
            hx-trigger="change"
            hx-target="#filter-results"
            hx-push-url="true">
            <option value="">Default</option>
            <option value="name-asc">Name (A-Z)</option>
            <option value="name-desc">Name (Z-A)</option>
            <option value="year-asc">Year (Oldest First)</option>
            <option value="year-desc">Year (Newest First)</option>
        </select>
    </div>
{{end}}