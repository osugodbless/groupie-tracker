{{define "artists-page"}}
<!--
  THESIS: The filter board is a mixing console, not a stack of bare browser fields. The category default is a toolbar of unstyled controls; this surface refuses it and gathers all five filters into one translucent glass console above the grid, with the active query readable at a glance.
  OWN-WORLD: #030712 chamber lit by the three neon glow pools; one glass console (white/5 fill, 1px hairlines, 16px radius), DM Sans labels and values, Space Grotesk numerals; the only bright elements are the cyan search focus, the cyan active hairlines, and the cyan chips.
  STORY: A visitor steps onto the floor, dials the console - search, sort, first album, members, location - and watches the lineup redraw with every turn, reading exactly what is active from the chip rail below.
  FIRST VIEWPORT: the glass console sits directly above the artist grid at container width; the search field owns the space, four selector tiles stand beside it, and an active-chip rail with clear-all appears only once a filter is set.
  FORM: one glass control bar, dressed with live active states and clearable chips; the voice is the venue's own glass plus cyan.
-->
<div id="artists-page">
    <!-- Hero -->
    <div class="relative overflow-hidden">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 sm:pt-8 pb-8 sm:pb-8">
            <div class="text-center max-w-3xl mx-auto">
                <div class="hero-badge inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/5 border border-white/10 text-sm text-gray-300 mb-8">
                    <span class="w-1.5 h-1.5 rounded-full bg-neon-cyan animate-pulse"></span>
                    Browse the lineup
                </div>
            </div>
        </div>
    </div>

    <!-- Filter console -->
    <div id="filter-board" class="filters max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-10">
        <div class="rounded-2xl border border-white/10 bg-white/5 backdrop-blur-md">
            <div class="flex flex-wrap items-end gap-x-4 gap-y-4 px-4 sm:px-5 py-4 sm:py-5">
                {{template "filters:search" .}}
                {{template "filters:sort" .}}
                {{template "filters:firstalbum" .}}
                {{template "filters:members" .}}
                {{template "filters:concertLoc" .}}
            </div>
            <div id="active-filters" class="border-t border-white/5 px-4 sm:px-5 py-2.5 is-empty" aria-live="polite"></div>
        </div>
    </div>

    <!-- Artist Grid -->
    <div id="artists" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-20 sm:pb-28">
        <div class="flex items-center justify-between mb-6">
            <div>
                <div class="w-10 h-0.5 bg-gradient-to-r from-neon-cyan to-neon-purple rounded-full mb-4"></div>
                <h2 class="font-heading text-2xl sm:text-3xl font-bold text-white text-balance">All Artists</h2>
                <p class="text-gray-500 text-sm mt-1">{{ len . }} artists</p>
            </div>
        </div>

        
        <div id="filter-results" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-3 sm:gap-4">
        {{template "artists:grid" .}}
        </div>
    </div>
</div>

<style>
    /* ---- Filter console: one glass board above the grid ---- */
    .filter-field {
        display: flex;
        flex-direction: column;
        gap: 6px;
        min-width: 0;
    }
    .filter-label {
        font-family: 'DM Sans', sans-serif;
        font-size: 0.6875rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: #9ca3af;
        transition: color 0.25s ease;
    }
    .filter-input {
        display: block;
        width: 100%;
        padding: 10px 14px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 10px;
        background: rgba(17, 24, 39, 0.5);
        color: #e5e7eb;
        font-family: 'DM Sans', sans-serif;
        font-size: 0.875rem;
        line-height: 1.25rem;
        transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    }
    .filter-input::placeholder {
        color: #94a3b8;
    }
    .filter-input:hover {
        border-color: rgba(255, 255, 255, 0.18);
    }
    .filter-input:focus {
        outline: none;
        border-color: rgba(34, 211, 238, 0.55);
        background: rgba(17, 24, 39, 0.65);
        box-shadow: 0 0 0 3px rgba(34, 211, 238, 0.15), 0 0 20px rgba(34, 211, 238, 0.08);
    }
    .filter-input:focus-visible {
        outline: 2px solid rgba(34, 211, 238, 0.45);
        outline-offset: 2px;
    }
    .filter-input[type="search"] {
        -webkit-appearance: none;
        appearance: none;
    }
    .filter-input::-webkit-search-cancel-button {
        display: none;
        -webkit-appearance: none;
    }
    .filter-input[type="date"],
    .filter-input[type="number"],
    .filter-select {
        color-scheme: dark;
    }
    .filter-select {
        -webkit-appearance: none;
        appearance: none;
        padding-right: 2.25rem;
        cursor: pointer;
    }
    .filter-select option {
        background-color: #111827;
        color: #e5e7eb;
    }
    .filter-field .filter-icon {
        color: #6b7280;
        transition: color 0.25s ease;
    }
    .filter-field:focus-within .filter-icon {
        color: #22d3ee;
    }
    .filter-field:focus-within .filter-label {
        color: #22d3ee;
    }

    /* Active filter state */
    .filter-field.filter-active .filter-label {
        color: #22d3ee;
    }
    .filter-field.filter-active .filter-input {
        border-color: rgba(34, 211, 238, 0.55);
    }
    .filter-field.filter-active .filter-icon {
        color: #22d3ee;
    }

    /* ---- Active-filter chip rail ---- */
    #active-filters {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
    }
    #active-filters.is-empty {
        display: none;
    }
    .filter-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 8px 5px 10px;
        border-radius: 9999px;
        border: 1px solid rgba(34, 211, 238, 0.3);
        background: rgba(34, 211, 238, 0.08);
        color: #22d3ee;
        font-family: 'DM Sans', sans-serif;
        font-size: 0.75rem;
        font-weight: 500;
        line-height: 1rem;
        animation: chip-in 0.25s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    .filter-chip:hover {
        border-color: rgba(34, 211, 238, 0.6);
        background: rgba(34, 211, 238, 0.12);
    }
    .filter-chip .chip-dot {
        width: 5px;
        height: 5px;
        border-radius: 9999px;
        background: #22d3ee;
    }
    .filter-chip button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 16px;
        height: 16px;
        border-radius: 9999px;
        color: #22d3ee;
        background: rgba(34, 211, 238, 0.12);
        transition: background 0.2s ease, color 0.2s ease;
    }
    .filter-chip button:hover {
        background: #22d3ee;
        color: #030712;
    }
    .clear-all-btn {
        margin-left: auto;
        padding: 5px 8px;
        border-radius: 8px;
        color: #9ca3af;
        font-family: 'DM Sans', sans-serif;
        font-size: 0.6875rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        transition: color 0.2s ease;
    }
    .clear-all-btn:hover {
        color: #ec4899;
    }
    @keyframes chip-in {
        from {
            opacity: 0;
            transform: translateY(4px) scale(0.96);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }
    @media (prefers-reduced-motion: reduce) {
        .filter-chip {
            animation: none;
        }
    }
</style>
{{end}}

{{define "artists:grid"}}
    {{ range . }}
    <div id="{{ .ID }}"
        data-artist-id="{{ .ID }}"
        data-artist-name="{{ .Name }}"
        hx-get="/artists/{{ .ID }}"
        hx-target="#artists-page"
        hx-push-url="true"
        hx-indicator="#loading-{{ .ID }}"
        class="card-glow card-animate group relative rounded-xl overflow-hidden bg-white/5 cursor-pointer hover:-translate-y-0.5 transition-transform duration-300">
        <div class="aspect-square overflow-hidden bg-white/5 relative">
            <img src="{{ .Image }}" alt="{{ .Name }}"
                class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500 ease-out"
                style="view-transition-name: at-{{ .ID }}"
                loading="lazy"
                onerror="this.classList.add('error')">
            <div class="img-fallback" aria-hidden="true">
                <svg viewBox="0 0 24 24" class="w-8 h-8 text-white/20" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"/>
                </svg>
            </div>
        </div>
        <div class="p-3 sm:p-4">
            <p class="font-heading font-semibold text-white text-sm sm:text-base truncate group-hover:text-neon-cyan transition-colors">{{ .Name }}</p>
            <div class="flex items-center gap-1.5 mt-1">
                <span class="w-1.5 h-1.5 rounded-full bg-neon-purple shrink-0"></span>
                <p class="text-xs text-gray-500">Est. {{ .CreationYear }}</p>
            </div>
        </div>
        <div id="loading-{{ .ID }}" class="hx-indicator absolute inset-0 bg-gray-950/80 z-10">
            <div class="p-4 space-y-3">
                <div class="skeleton h-4 bg-white/10 rounded w-3/4"></div>
                <div class="skeleton h-3 bg-white/10 rounded w-1/2"></div>
            </div>
        </div>
    </div>
    {{ else }}
    <div class="col-span-full text-center py-20">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-white/5 mb-4">
            <svg viewBox="0 0 24 24" class="w-8 h-8 text-white/20" fill="none" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"/>
            </svg>
        </div>
        <p class="text-gray-400 text-lg font-medium">No artists found</p>
    </div>
    {{ end }}
{{end}}

{{define "filters:search"}}
    <div class="filter-field grow basis-72 min-w-[240px]" data-filter="search" id="search-filter">
        <label for="filter-search-input" class="filter-label">Search</label>
        <div class="relative">
            <svg class="filter-icon pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 10.5a6.5 6.5 0 11-13 0 6.5 6.5 0 0113 0z"/>
            </svg>
            <input id="filter-search-input" class="filter-input pl-9" type="search"
                name="search" placeholder="Search artists"
                hx-get="/artists/findx"
                hx-trigger="input changed delay:500ms, keyup[key=='Enter']"
                hx-target="#filter-results"
                hx-indicator=".htmx-indicator"
                hx-push-url="true">
            <span class="htmx-indicator absolute right-3 top-1/2 -translate-y-1/2" aria-hidden="true">
                <svg class="animate-spin w-4 h-4 text-neon-cyan" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
            </span>
        </div>
    </div>
{{end}}

{{define "filters:sort"}}
    <div class="filter-field w-40" data-filter="sort" id="sort-filter">
        <label for="filter-sort" class="filter-label">Sort</label>
        <div class="relative">
            <select id="filter-sort" class="filter-input filter-select pr-9"
                name="sort"
                hx-get="/artists/findx"
                hx-trigger="change"
                hx-target="#filter-results"
                hx-push-url="true">
                <option value="default">Default</option>
                <option value="name-asc">Name (A-Z)</option>
                <option value="name-desc">Name (Z-A)</option>
                <option value="creation-asc">Founded (oldest)</option>
                <option value="creation-desc">Founded (newest)</option>
            </select>
            <svg class="filter-icon pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
        </div>
    </div>
{{end}}

{{define "filters:firstalbum"}}
    <div class="filter-field w-80" data-filter="firstalbum" id="first-album-filter">
        <label for="filter-from" class="filter-label">First album</label>
        <form class="relative flex items-center gap-2"
            hx-get="/artists/findx"
            hx-target="#filter-results"
            hx-trigger="change delay:300ms from:#filter-from, change delay:300ms from:#filter-to"
            hx-push-url="true"
            onsubmit="return false;">
            <input type="date" id="filter-from" name="from_date" value="1950-01-01" class="filter-input flex-1 min-w-0">
            <span class="text-gray-500 text-xs shrink-0" aria-hidden="true">to</span>
            <input type="date" id="filter-to" name="to_date" value="2025-12-31" class="filter-input flex-1 min-w-0" aria-label="To date">
        </form>
    </div>
{{end}}

{{define "filters:members"}}
    <div class="filter-field w-28" data-filter="members" id="members-filter">
        <label for="filter-members" class="filter-label">Members</label>
        <form class="relative"
            hx-get="/artists/findx"
            hx-target="#filter-results"
            hx-trigger="change delay:500ms from:#filter-members"
            hx-push-url="true"
            onsubmit="return false;">
            <input id="filter-members" class="filter-input pl-9" type="number" name="members" min="1" placeholder="Any">
            <svg class="filter-icon pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
        </form>
    </div>
{{end}}

{{define "filters:concertLoc"}}
    <div class="filter-field w-56" data-filter="loc" id="concert-loc-filter">
        <label for="filter-loc" class="filter-label">Location</label>
        <form class="relative"
            hx-get="/artists/findx"
            hx-trigger="change"
            hx-target="#filter-results"
            hx-push-url="true"
            onsubmit="return false;">
            <select id="filter-loc" class="filter-input filter-select pr-9" name="concert-loc">
                <option value="">All locations</option>
                {{ range . }}
                {{ range $k, $v := .DatesLocation }}
                <option value="{{ $k }}">{{ clean $k }}</option>
                {{ end }}
                {{ end }}
            </select>
            <svg class="filter-icon pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
        </form>
    </div>
{{end}}
