<div id="tourDates" class="page-entrance space-y-8">
    
    <!-- Tour Dates Timeline -->
    <div class="space-y-6">
        <div class="flex items-center gap-3">
            <span class="text-2xl">🗺️</span>
            <h2 class="font-heading text-2xl font-bold text-balance text-white">{{ .Name }} &mdash; Tour Dates</h2>
        </div>

        <div class="relative">
            <!-- Timeline Line -->
            <div class="absolute left-4 top-0 bottom-0 w-0.5 bg-gradient-to-b from-neon-cyan via-neon-purple to-neon-pink"></div>

            <!-- Timeline Items -->
            <div class="space-y-8">
                {{ range $k, $v := .DatesLocation }}
                <div class="timeline-item relative flex items-start gap-4 md:gap-8">
                    <!-- Timeline Dot -->
                    <div class="absolute left-4 w-4 h-4 -ml-2 bg-neon-cyan rounded-full border-4 border-gray-950 z-10"></div>
                    
                    <!-- Content -->
                    <div class="ml-12 md:ml-0 md:w-1/2 md:pl-12">
                        <div class="bg-gray-900/50 border border-gray-800 rounded-xl p-4 hover:border-neon-cyan/30 transition-colors">
                            <div class="flex items-center gap-2 mb-3">
                                <span class="text-lg">📍</span>
                                <h4 class="font-heading font-semibold text-lg text-white capitalize">{{ clean $k }}</h4>
                            </div>
                            <div class="flex flex-wrap gap-2">
                                {{ range $v }}
                                <span class="px-3 py-1.5 bg-gray-800/50 border border-gray-700 rounded-lg text-gray-300 text-sm hover:border-neon-pink/50 hover:text-neon-pink transition-colors">
                                    {{ . }}
                                </span>
                                {{ end }}
                            </div>
                        </div>
                    </div>
                </div>
                {{ else }}
                <div class="text-center py-16">
                    <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-white/5 mb-4">
                        <svg viewBox="0 0 24 24" class="w-8 h-8 text-white/20" fill="none" stroke="currentColor" stroke-width="1.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"/>
                        </svg>
                    </div>
                    <p class="text-gray-400 text-lg font-medium">No tour dates yet</p>
                    <p class="text-gray-600 text-sm mt-1">This artist hasn&rsquo;t announced any concerts yet. Check back later.</p>
                </div>
                {{ end }}
            </div>
        </div>
    </div>
</div>
