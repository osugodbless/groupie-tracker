{{define "artists-page"}}
<div id="artists-page">
    <!-- Hero -->
    <div class="relative overflow-hidden">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 sm:pt-8 pb-8 sm:pb-8">
            <div class="text-center max-w-3xl mx-auto">
                <div class="hero-badge inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/5 border border-white/10 text-sm text-gray-300 mb-8">
                    <span class="w-1.5 h-1.5 rounded-full bg-neon-cyan animate-pulse"></span>
                    Browse the lineup
                </div>
            </div>
        </div>
    </div>

    <!-- Filter console -->
    <div id="filter-board" class="filters max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-10">
        <div class="rounded-2xl border border-white/10 bg-white/5 backdrop-blur-md">
            <div class="flex flex-wrap items-end gap-x-4 gap-y-4 px-4 sm:px-5 py-4 sm:py-5">
                {{template "filters:bar" .}}
            </div>
            <div id="active-filters" class="border-t border-white/5 px-4 sm:px-5 py-2.5 is-empty" aria-live="polite"></div>
        </div>
    </div>

    <!-- Artist Grid -->
    <div id="artists" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-20 sm:pb-28">
        <div class="flex items-center justify-between mb-6">
            <div>
                <div class="w-10 h-0.5 bg-gradient-to-r from-neon-cyan to-neon-purple rounded-full mb-4"></div>
                <h2 class="font-heading text-2xl sm:text-3xl font-bold text-white text-balance">All Artists</h2>
                <p class="text-gray-500 text-sm mt-1">{{ len . }} artists</p>
            </div>
        </div>

        
        <div id="filter-results" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-3 sm:gap-4">
        {{template "artists:grid" .}}
        </div>
    </div>
</div>
{{end}}

{{define "artists:grid"}}
    {{ range . }}
    <div id="{{ .ID }}"
        data-artist-id="{{ .ID }}"
        data-artist-name="{{ .Name }}"
        hx-get="/artists/{{ .ID }}"
        hx-target="#artists-page"
        hx-push-url="true"
        hx-indicator="#loading-{{ .ID }}"
        class="card-glow card-animate group relative rounded-xl overflow-hidden bg-white/5 cursor-pointer hover:-translate-y-0.5 transition-transform duration-300">
        <div class="aspect-square overflow-hidden bg-white/5 relative">
            <img src="{{ .Image }}" alt="{{ .Name }}"
                class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500 ease-out"
                style="view-transition-name: at-{{ .ID }}"
                loading="lazy"
                onerror="this.classList.add('error')">
            <div class="img-fallback" aria-hidden="true">
                <svg viewBox="0 0 24 24" class="w-8 h-8 text-white/20" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"/>
                </svg>
            </div>
        </div>
        <div class="p-3 sm:p-4">
            <p class="font-heading font-semibold text-white text-sm sm:text-base truncate group-hover:text-neon-cyan transition-colors">{{ .Name }}</p>
            <div class="flex items-center gap-1.5 mt-1">
                <span class="w-1.5 h-1.5 rounded-full bg-neon-purple shrink-0"></span>
                <p class="text-xs text-gray-500">Est. {{ .CreationYear }}</p>
            </div>
        </div>
        <div id="loading-{{ .ID }}" class="hx-indicator absolute inset-0 bg-gray-950/80 z-10">
            <div class="p-4 space-y-3">
                <div class="skeleton h-4 bg-white/10 rounded w-3/4"></div>
                <div class="skeleton h-3 bg-white/10 rounded w-1/2"></div>
            </div>
        </div>
    </div>
    {{ else }}
    <div class="col-span-full text-center py-20">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-white/5 mb-4">
            <svg viewBox="0 0 24 24" class="w-8 h-8 text-white/20" fill="none" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"/>
            </svg>
        </div>
        <p class="text-gray-400 text-lg font-medium">No artists found</p>
    </div>
    {{ end }}
{{end}}

{{define "filters:bar"}}
<form id="filters-form"
    hx-get="/artists/filter"
    hx-target="#filter-results"
    hx-trigger="input changed delay:500ms from:input[type='search'], change from:select, change delay:300ms from:input[type='date'], change delay:500ms from:input[type='number']"
    hx-indicator=".htmx-indicator"
    hx-push-url="true"
    class="flex flex-wrap items-end gap-4"
    onsubmit="return false;">

    {{template "filters:search" .}}
    {{template "filters:sort" .}}
    {{template "filters:firstalbum" .}}
    {{template "filters:members" .}}
    {{template "filters:concertLoc" .}}

</form>
{{end}}

{{define "filters:search"}}
    <div class="filter-field grow basis-72 min-w-[240px]" data-filter="search" id="search-filter">
        <label for="filter-search-input" class="filter-label">Search</label>
        <div class="relative">
            <svg class="filter-icon pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 10.5a6.5 6.5 0 11-13 0 6.5 6.5 0 0113 0z"/>
            </svg>
            <!-- hx-get removed here; parent form handles submission -->
            <input id="filter-search-input" class="filter-input pl-9" type="search"
                name="search" placeholder="Search artists">
            
            <span class="htmx-indicator absolute right-3 top-1/2 -translate-y-1/2" aria-hidden="true">
                <svg class="animate-spin w-4 h-4 text-neon-cyan" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
            </span>
        </div>
    </div>
{{end}}

{{define "filters:sort"}}
    <div class="filter-field w-40" data-filter="sort" id="sort-filter">
        <label for="filter-sort" class="filter-label">Sort</label>
        <div class="relative">
            <!-- hx-get removed; change event bubbled to parent form -->
            <select id="filter-sort" class="filter-input filter-select pr-9" name="sort">
                <option value="default">Default</option>
                <option value="name-asc">Name (A-Z)</option>
                <option value="name-desc">Name (Z-A)</option>
                <option value="creation-asc">Founded (oldest)</option>
                <option value="creation-desc">Founded (newest)</option>
            </select>
            <svg class="filter-icon pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
        </div>
    </div>
{{end}}

{{define "filters:firstalbum"}}
    <div class="filter-field w-80" data-filter="firstalbum" id="first-album-filter">
        <label for="filter-from" class="filter-label">First album</label>
        <!-- Removed nested <form> tag to prevent invalid HTML nested forms -->
        <div class="relative flex items-center gap-2">
            <input type="date" id="filter-from" name="from_date" class="filter-input flex-1 min-w-0">
            <span class="text-gray-500 text-xs shrink-0" aria-hidden="true">to</span>
            <input type="date" id="filter-to" name="to_date" class="filter-input flex-1 min-w-0" aria-label="To date">
        </div>
    </div>
{{end}}

{{define "filters:members"}}
    <div class="filter-field w-28" data-filter="members" id="members-filter">
        <label for="filter-members" class="filter-label">Members</label>
        <!-- Removed nested <form> tag -->
        <div class="relative">
            <input id="filter-members" class="filter-input pl-9" type="number" name="members" min="1" placeholder="Any">
            <svg class="filter-icon pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
        </div>
    </div>
{{end}}

{{define "filters:concertLoc"}}
    <div class="filter-field w-56" data-filter="loc" id="concert-loc-filter">
        <label for="filter-loc" class="filter-label">Location</label>
        <!-- Removed nested <form> tag -->
        <div class="relative">
            <select id="filter-loc" class="filter-input filter-select pr-9" name="concert-loc">
                <option value="">All locations</option>
                {{ range . }}
                {{ range $k, $v := .DatesLocation }}
                <option value="{{ $k }}">{{ clean $k }}</option>
                {{ end }}
                {{ end }}
            </select>
            <svg class="filter-icon pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
        </div>
    </div>
{{end}}